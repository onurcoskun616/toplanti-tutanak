# Copy to .env and adjust as needed. All values here are also the defaults.

DATABASE_URL=sqlite+aiosqlite:///./toplanti.db

# Comma-separated list of extra allowed origins for the frontend (the
# published GitHub Pages origin is included by default; localhost is always
# allowed separately for local dev).
CORS_ORIGINS=https://onurcoskun616.github.io

# ASR (faster-whisper)
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=tr
